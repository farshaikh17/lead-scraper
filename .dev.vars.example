# Copy to .dev.vars (git-ignored) for `npm run dev`.
APIFY_API_TOKEN=

# Set to 1 to serve runs from src/fixtures/sample-dataset.json instead of calling Apify.
APIFY_MOCK=0

# Telnyx Number Lookup: mobile / landline / VoIP check (~$0.0015-0.0025 per number). Used first when set.
# The Telnyx account must be upgraded (telnyx.com/upgrade) before lookups are allowed.
TELNYX_API_KEY=

# Optional: free key from veriphone.io (1,000 phone checks/month). Leave empty to only detect toll-free numbers.
VERIPHONE_API_KEY=

# Client access (Google Business Profile access requests, /access and /connect/<link>). See docs/gbp-access.md.
# GBP_MODE: mock = sample profiles, nothing sent to Google (test the pages); manual = the client gets the
# step-by-step guide; live = Google sign-in + automatic invitations (needs the four values below). Default: manual.
GBP_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
TOKEN_ENC_KEY=
# Any long random text (signs the sign-in state and the client's browser cookie)
STATE_SIGNING_SECRET=
# Emails (Resend). Sender: GBP_EMAIL_FROM, or the store's "Send emails from" address.
RESEND_API_KEY=
GBP_EMAIL_FROM=
# When the client pages run as their own app (wrangler.access.jsonc), Lead Finder gets its address and the
# client app gets Lead Finder's (for the button in emails). Leave empty to serve the pages from Lead Finder.
CLIENT_ACCESS_URL=
LEAD_FINDER_URL=
