{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Workers Paid: Cloudflare's default CPU time per request, written down (only paid accounts can set it,
  // so a release on the free plan would be refused here instead of quietly hitting free-plan limits).
  "limits": { "cpu_ms": 30000 },

  // Polls in-flight Apify runs and ingests finished datasets. A webhook would be
  // faster, but the Worker sits behind Cloudflare Access, so Apify can't reach it.
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lead-scraper-db",
      "database_id": "cafa4171-18dc-4dba-bbc0-ef86a1561cd0",
      // This computer's test copy (npm run dev) stays separate from the live database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Saving a finished pull: each step saves ~1,000 businesses, then queues the next step,
  // so a big pull is saved back-to-back instead of one step per cron minute.
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "lead-scraper-ingest" }],
    "consumers": [{ "queue": "lead-scraper-ingest", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 2 }]
  },

  // Nightly database backups (src/backup.ts). Private: nothing in it is public.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "lead-scraper-backups" }],

  "vars": {
    // Actor to run. Swappable: see src/apify.ts for the supported input builders.
    // compass is used because it reports claimed/verified status (claimThisBusiness);
    // scraperlink is ~8x cheaper but can't tell verified from unverified profiles.
    "APIFY_ACTOR_ID": "compass~crawler-google-places",
    "SOURCE_CODE_DEFAULT": "ILS",
    "MAX_RESULTS_DEFAULT": "500",
    // Hard ceiling per search, even with "No limit" (which is capped at the Google count + 15%).
    "MAX_RESULTS_CEILING": "150000",
    // Timezone used for the Lead Date / Lead Date & Time columns.
    "LEAD_TIMEZONE": "America/New_York",
    // Nightly backups: "1" = on (keeps the newest 14; well inside the R2 free tier).
    "BACKUPS_ENABLED": "1",
    // Where the free collector (GitHub Actions workflow free-collect.yml) lives.
    "GITHUB_REPO": "Mianrodev/lead-scraper"
  }

  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  //   APIFY_API_TOKEN
  //   TELNYX_API_KEY     (phone line type via live carrier lookup; preferred when set)
  //   VERIPHONE_API_KEY  (fallback; free tier 1,000/month, number-range data)
  //   ANTHROPIC_API_KEY  (Phase 2)
}
